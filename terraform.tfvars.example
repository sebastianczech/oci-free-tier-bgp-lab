# cp terraform.tfvars.example terraform.tfvars
compartment_id = "ocid1.tenancy.oc1..xxxx" # the tenancy OCID = root compartment

# Optional: by default the DEFAULT profile in ~/.oci/config and its region are used
# config_file_profile  = "DEFAULT"
# region               = "eu-frankfurt-1"

# ssh_public_key_path  = "~/.ssh/id_rsa.pub"
# ssh_private_key_path = "~/.ssh/id_rsa"
# micro_ad_index       = 0 # the AD where your tenancy has the E2.1.Micro limit (see README)
